  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test-headless": "ng test --no-watch --no-progress --browsers=ChromeHeadlessCI",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev": "vite",
    "build:react": "vite build",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "lint:react": "eslint --config .eslintrc.react.cjs web --ext .ts,.tsx",
    "test:unit": "vitest run",
    "test:e2e:migrated": "node scripts/run-migrated-specs.mjs",
    "format": "prettier --write web",
    "format:check": "prettier --check web",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "16.2.1",
